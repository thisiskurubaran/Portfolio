# Every service is optional. Without its keys a feature says it is not
# connected instead of pretending to work. Never commit a real .env file.

# Upstash Redis: guestbook, sticky notes, rate limits and the threat log.
# Without it, development keeps data in memory and production refuses writes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing IP addresses. Use a long random string in production.
IP_HASH_SALT=

# Secret for owner-only deletes: DELETE /api/admin/guestbook?id=... with the
# x-admin-secret header.
ADMIN_SECRET=

# Contact form relay (Resend). The Mail app stays disabled until both are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender, for a verified domain.
CONTACT_FROM_EMAIL=

# PartyKit host for visitor presence, e.g. kbos-presence.<user>.partykit.dev
# (127.0.0.1:1999 with `npx partykit dev`).
NEXT_PUBLIC_PARTYKIT_HOST=
