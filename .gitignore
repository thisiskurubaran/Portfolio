# Applies to every project in the repo. Each project keeps its own
# .gitignore for anything specific to it.

# local AI tooling, never committed
.claude/
CLAUDE.md
CLAUDE.local.md

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# build output
.next/
out/
next-env.d.ts
*.tsbuildinfo
build/
dist/

# env files
.env
.env*.local
.env.*
!.env.example

# deploy and realtime tooling
.vercel/
.partykit/
.wrangler/

# testing
coverage/
playwright-report/
test-results/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editors and os
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
